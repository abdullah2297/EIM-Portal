# ---------------------------------------------------------------------------
# EIM Portal environment configuration
# Copy this file to `.env.local` before running the project.
# ---------------------------------------------------------------------------

# Base URL used by the service layer for server-side fetches.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string (from a free Neon project - neon.tech). All
# content lives here as one JSONB blob per collection; see lib/db.js.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Read/write token for Vercel Blob storage (Vercel dashboard -> your project
# -> Storage -> create a Blob store -> copy the token it generates). Used for
# every admin-uploaded image and zip attachment; see lib/uploads.js.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Admin panel credentials (used by /admin/login).
# PLACEHOLDER - replace with your department's own values before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=eim-admin-2026

# Secret used to sign the admin session cookie.
# PLACEHOLDER - replace with a long random string in any real deployment.
AUTH_SECRET=replace-this-with-a-long-random-secret-string

# Session lifetime in hours.
AUTH_SESSION_HOURS=12
